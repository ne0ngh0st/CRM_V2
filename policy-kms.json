{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KmsSomenteAtravesDosServicosDoCrmV2",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:ListAliases",
        "kms:CreateGrant",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "rds.sa-east-1.amazonaws.com",
            "secretsmanager.sa-east-1.amazonaws.com",
            "s3.sa-east-1.amazonaws.com",
            "elasticache.sa-east-1.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "SecretsGerenciadosPeloRds",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:TagResource",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*"
    }
  ]
}
