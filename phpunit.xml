<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Sem broadcast em teste: o NotificacaoService dispara um evento pro Reverb, e
             sem isto qualquer teste que gere notificação tenta abrir conexão com um
             servidor WebSocket que não existe aqui, falhando com "Pusher error". A
             notificação em si continua sendo gravada e verificável no banco. -->
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- NÃO comentar/alterar estas duas linhas. Sem elas os testes rodam contra a
             conexão padrão (o palma_v2 de desenvolvimento) e o RefreshDatabase faz
             migrate:fresh nele, apagando todo o dado importado do legado — aconteceu em
             2026-08-10. force="true" garante que nem variável de ambiente do container
             sobrescreve. A trava em tests/TestCase.php segura se isto for mexido.
             É MySQL e não SQLite de propósito: as queries do projeto usam SQL específico
             de MySQL (CONCAT, orderByRaw '... IS NULL', COUNT(DISTINCT)), então testar
             em SQLite daria confiança falsa — e o SQLite em memória ainda quebra o
             RefreshDatabase aqui ("no such table: roles"). -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="palma_v2_test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
