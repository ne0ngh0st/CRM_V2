{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarApenasEsteBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::crm-v2-arquivos-890615325644"
    },
    {
      "Sid": "ObjetosDesteBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::crm-v2-arquivos-890615325644/*"
    }
  ]
}
