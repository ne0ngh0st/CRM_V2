APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Discos logicos (ver config/filesystems.php e docs/deploy-aws.md 5.4).
# Em producao com 2 app nodes os DOIS precisam ser s3: arquivo gravado no disco
# local do no A nao existe no no B.
UPLOADS_DISK=public
EXPORTS_DISK=local
QUEUE_CONNECTION=redis

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Preenchido = TODA solicitação de cadastro (bobina/etiqueta/cliente) vai para este
# endereço em vez do PCP e do Cadastro, com o destino real no prefixo do assunto.
# Vazio = vai para os setores de verdade. Não afeta a redefinição de senha, que sempre
# vai para quem pediu. Depois de mudar: php artisan config:cache
CADASTROS_REDIRECIONAR_PARA=

# Relatório Power BI da Home (supervisor/admin/diretor). Sem esta linha, vale
# o default de config/powerbi.php (BI_RADES). URL fora de app.powerbi.com =
# o embed some. Não deixar vazio no .env — string vazia sobrescreve o default.
# POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=...

# Webhook de leads do site (WordPress). Vazio = endpoint recusa com 503
# (desligado). O plugin do site so tem campo de URL, entao o valor vai como
# ?token=... no fim da URL do webhook. Header tambem e aceito.
# Gere com: php artisan tinker --execute="echo Str::random(48);"
# Dono comercial: tabela marketing_wp_formularios (não é env).
WP_LEADS_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Lado CLIENTE (browser): fixo em localhost, porque o container do Reverb publica a
# 8082 no host. Nao derivar de REVERB_HOST, que agora aponta pro servico interno.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8082
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Pasta dos relatorios do TOTVS no HOST (o docker-compose monta em /relatorios, read-only).
# Dentro do container o caminho e /relatorios -- ver config/totvs.php.
TOTVS_RELATORIOS_PATH="C:/caminho/para/RELATORIOS TOTVS/CSV"
